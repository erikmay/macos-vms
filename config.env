# Defaults for all scripts. Do not edit: put your values in config.local.env
# (git-ignored), which is read after this file.

# The Mac that runs the VMs: an SSH destination (host alias, user@host), or `local`
# to run the VMs on this Mac. Required.
VM_HOST=

# VM naming and size. Apple's license allows at most 2 running macOS guests per host.
VM_PREFIX=mac-vm
VM_CPU=4
VM_MEMORY_MB=6144

# Upstream base image and the name of the golden image built from it.
BASE_IMAGE=ghcr.io/cirruslabs/macos-tahoe-base:latest
GOLDEN_IMAGE=mac-agent-golden

# T3 Code server version inside the VMs. Keep it equal to your desktop app's version.
T3_VERSION=0.1.8

# Ports on this Mac's loopback for VM N: T3 on 1377N, the voxl screen stream on
# 1690N (make view), Screen Sharing on 1590N (make vnc).
T3_LOCAL_PORT_BASE=13770
VOXL_LOCAL_PORT_BASE=16900
VNC_LOCAL_PORT_BASE=15900

# voxl (https://github.com/tembo/voxl) streams each VM's screen to the browser. It is
# built from crates.io inside the image (MIT; the binary links x264 and so is GPL-2.0).
VOXL_VERSION=0.3.4

# Flags for `tart run`. --net-softnet: a VM reaches the internet, but no private
# address ranges (your LAN, VPNs, the other VM). The host can still connect to the VM.
# Do not add --net-softnet-expose: it also listens on the host's LAN address.
TART_RUN_FLAGS="--no-graphics --net-softnet"

# Pinned host tooling, installed by `make host`.
TART_VERSION=2.41.1
SOFTNET_VERSION=0.25.0

# Login of the guest user, for Screen Sharing (`make vnc`). The Cirrus Labs images
# use admin / admin.
VM_USER=admin
VM_PASSWORD=admin

# Keychain item on this Mac that holds the Claude Code token (`make token`).
CLAUDE_TOKEN_KEYCHAIN_SERVICE=macos-vms-claude-oauth-token
